<button class="menubtn" onclick="$('nav').classList.toggle('open')">☰ Menú ▾</button><div class="nav" id="nav"></div><div id="who" style="font-size:12px;color:#bbb;text-align:center;margin:14px 0 6px"></div><button class="sb" style="width:100%" onclick="logout()">🚪 Salir</button></aside>
<main>
