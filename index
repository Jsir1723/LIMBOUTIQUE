<div class="panel" style="margin-top:14px"><h3>Ventas registradas</h3><table><thead><tr><th>Fecha</th><th>Producto</th><th>Cant.</th><th>Pago</th><th>Vendedora</th><th>Total</th><th></th></tr></thead><tbody id="salB"></tbody></table></div></section>

<section id="egresos" class="section"><div class="top"><div><h1>Egresos</h1><div class="sub">Control de gastos</div></div><button class="primary" onclick="openE()">+ Registrar egreso</button></div>
<div class="panel"><table><thead><tr><th>Fecha</th><th>Concepto</th><th>Categoría</th><th>Monto</th><th></th></tr></thead><tbody id="expB"></tbody></table></div></section>

<section id="reportes" class="section"><div class="top"><div><h1>Reportes</h1><div class="sub">Filtra por mes (vacío = todo el historial)</div></div>
<div class="toolbar"><input id="mSel" type="month" onchange="refresh()"><button class="secondary" onclick="csv('ventas',salRows())">⬇ Ventas</button><button class="secondary" onclick="csv('ventas_por_dia',dayCsv())">⬇ Por día</button><button class="secondary" onclick="csv('egresos',expRows())">⬇ Egresos</button></div></div>
<div class="cards"><div class="card"><div class="label">Ventas</div><div class="value" id="rS">-</div></div><div class="card"><div class="label">Egresos</div><div class="value" id="rE">-</div></div><div class="card"><div class="label">Resultado (ventas − egresos)</div><div class="value" id="rR">-</div></div><div class="card"><div class="label">Margen bruto (ventas − costo)</div><div class="value" id="rM">-</div></div></div>
<div class="grid"><div class="panel"><h3>Ventas por método de pago</h3><table id="rPay"></table></div><div class="panel"><h3>Egresos por categoría</h3><table id="rCat"></table></div></div>
<div class="panel" style="margin-top:14px"><h3>Historial diario de ventas (se guarda solo con cada venta)</h3><table><thead><tr><th>Día</th><th>Ventas</th><th>Unid.</th><th>Yappy</th><th>Transf.</th><th>Efectivo</th><th>Total</th><th></th></tr></thead><tbody id="dayB"></tbody></table></div></section>

<section id="usuarios" class="section"><div class="top"><div><h1>Usuarios</h1><div class="sub">Personas que podrán entrar a LIM BOUTIQUE</div></div><button class="primary" onclick="openU()">+ Nuevo usuario</button></div>
<div class="panel"><table><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th></th></tr></thead><tbody id="usrB"></tbody></table></div>
<div class="notice"><b>Nota:</b> las contraseñas se cambian desde Supabase (Authentication → Users).</div></section>
</main>

<div class="modal" id="pM"><div class="modalbox"><div class="modalhead"><h2 id="pT"></h2><button class="x" onclick="cm('pM')">×</button></div>
<div class="formgrid"><input id="pCode" placeholder="Código / SKU"><input id="pName" placeholder="Nombre"><select id="pCat"><option>Ropa</option><option>Calzado</option><option>Carteras</option><option>Accesorios</option></select><input id="pCost" type="number" step=".01" placeholder="Costo B/."><input id="pPrice" type="number" step=".01" placeholder="Precio venta B/."></div><div style="font-weight:700;font-size:13px;margin:14px 0 4px">Variantes (talla, color y existencia)</div><div id="varBox"></div><button class="sb" onclick="addVar()">+ Agregar variante</button>
<div class="sp"><span id="pPrev"></span><input id="pFile" type="file" accept="image/*" onchange="pickPhoto(this)"><button class="sb" onclick="clrPhoto()">Quitar foto</button></div>
<div style="margin-top:15px"><button class="primary" onclick="saveP()">Guardar</button></div></div></div>

<div class="modal" id="eM"><div class="modalbox"><div class="modalhead"><h2 id="eT"></h2><button class="x" onclick="cm('eM')">×</button></div>
<div class="formgrid"><input id="eC" placeholder="Concepto"><select id="eCat"><option>Compra de mercancía</option><option>Transporte</option><option>Publicidad</option><option>Servicios</option><option>Otros</option></select><input id="eA" type="number" step=".01" placeholder="Monto B/."></div>
<div style="margin-top:15px"><button class="primary" onclick="saveE()">Guardar</button></div></div></div>

<div class="modal" id="uM"><div class="modalbox"><div class="modalhead"><h2 id="uT"></h2><button class="x" onclick="cm('uM')">×</button></div>
<div class="formgrid"><input id="uN" placeholder="Nombre completo"><input id="uU" placeholder="Correo"><select id="uR" onchange="rolePerms()"><option>Administradora</option><option>Vendedora</option><option>Contabilidad</option></select><input id="uP" type="password" placeholder="Contraseña"></div>
<div style="margin-top:15px;font-weight:700;font-size:13px">Permisos</div>
<div class="switches"><label class="check"><input id="pm_inv" type="checkbox"> Inventario</label><label class="check"><input id="pm_sales" type="checkbox"> Ventas</label><label class="check"><input id="pm_exp" type="checkbox"> Egresos</label><label class="check"><input id="pm_rep" type="checkbox"> Reportes</label><label class="check"><input id="pm_users" type="checkbox"> Usuarios</label></div>
<div style="margin-top:15px"><button class="primary" onclick="saveU()">Guardar usuario</button></div></div></div>

<div id="toast"></div>
<div class="modal" id="cf"><div class="modalbox" style="width:min(380px,100%)"><p id="cfT" style="margin-top:0"></p><div class="acts"><button class="primary" id="cfY">Sí, continuar</button><button class="secondary" onclick="cm('cf')">Cancelar</button></div></div></div>
<div class="modal" id="sM"><div class="modalbox" style="width:min(380px,100%)"><div class="modalhead"><h2 id="stT"></h2><button class="x" onclick="cm('sM')">×</button></div><div class="formgrid" style="grid-template-columns:1fr"><select id="stV"></select><input id="stQ" type="number" min="1" value="1" placeholder="Unidades que llegaron"></div><div style="margin-top:15px"><button class="primary" onclick="doStock()">Sumar al stock</button></div></div></div>
<div class="modal show" id="lg" style="z-index:9;background:var(--bg)"><div class="modalbox" style="width:min(380px,100%)"><div class="modalhead"><h2>LIM BOUTIQUE · Iniciar sesión</h2></div><div class="formgrid" style="grid-template-columns:1fr"><input id="lu" type="email" placeholder="Correo" autocapitalize="off"><input id="lp" type="password" placeholder="Contraseña" onkeydown="if(event.key==='Enter')login()"></div><div style="margin-top:15px"><button class="primary" onclick="login()">Entrar</button></div></div></div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.js"></script>
<script>
const K='limboutique_v6',$=id=>document.getElementById(id),uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const money=n=>'B/. '+Number(n||0).toFixed(2),fd=t=>new Date(t).toLocaleString('es-PA');
const ym=t=>{const d=new Date(t);return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')};
const PERMS=['inv','sales','exp','rep','users'],ROLES={Administradora:[1,1,1,1,1],Vendedora:[0,1,0,0,0],Contabilidad:[0,0,1,1,0]};
const mkU=(name,user,role)=>{const u={name,user,role,pass:'1234',active:true};PERMS.forEach((p,i)=>u[p]=!!ROLES[role][i]);return u};
// ===== CONFIGURACIÓN: pega aquí los datos de tu proyecto de Supabase =====
const SB_URL='https://wmtyfapjxduelieftjfg.supabase.co',SB_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndtdHlmYXBqeGR1ZWxpZWZ0amZnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEyNTMwNTcsImV4cCI6MjEwNjgyOTA1N30.CDl0nNXevnfFVZoOfkQEBJdOD6b4Xu12h9aNonvIqg0';
const sb=SB_URL.startsWith('PEGA')?null:supabase.createClient(SB_URL,SB_KEY);
let db={products:[],sales:[],expenses:[],users:[]};
const chk=r=>{if(r&&r.error){alert(r.error.message);return false}return true};
async function load(){const g=async(tb,ok,o)=>ok?(await sb.from(tb).select('*').order(o,{ascending:o==='name'})).data||[]:[];
db.products=await g('products',true,'name');db.sales=await g('sales',true,'ts');db.expenses=await g('expenses',can('exp')||can('rep'),'ts');db.users=await g('profiles',can('users'),'name');refresh()}
function save(){load()}
const TABS=[['inicio','🏠 Inicio'],['inventario','👗 Inventario'],['ventas','🛍️ Ventas'],['egresos','💸 Egresos'],['reportes','📊 Reportes'],['usuarios','👥 Usuarios']];
$('nav').innerHTML=TABS.map(t=>`<button data-id="${t[0]}" onclick="show('${t[0]}')">${t[1]}</button>`).join('');
window.alert=m=>{const e=$('toast');e.textContent=m;e.style.display='block';clearTimeout(window._t);window._t=setTimeout(()=>e.style.display='none',8000)};
let cfFn=null;function ask(m,fn){$('cfT').textContent=m;cfFn=fn;om('cf')}$('cfY').onclick=()=>{cm('cf');if(cfFn)cfFn()};
const A={inicio:'rep',inventario:'inv',ventas:'sales',egresos:'exp',reportes:'rep',usuarios:'users'};
let S=null;const can=k=>!!(S&&S[k]);
async function boot(){if(!sb){alert('Falta pegar la URL y la clave de Supabase dentro del archivo.');return}const {data:{session}}=await sb.auth.getSession();if(session)await afterAuth(session.user)}
async function afterAuth(u){const {data,error:pe}=await sb.from('profiles').select('*').eq('id',u.id).maybeSingle();if(!data||!data.active){alert(pe?'Error al leer el perfil: '+pe.message:'Tu usuario no tiene perfil activo. Habla con la administradora.');await sb.auth.signOut();S=null;return}S=data;await load();enter()}
async function login(){if(!sb){alert('Falta configurar Supabase en el archivo.');return}const {data,error}=await sb.auth.signInWithPassword({email:val('lu'),password:$('lp').value});if(error){alert('No se pudo entrar: '+error.message+(error.status?' (código '+error.status+')':''));return}$('lp').value='';await afterAuth(data.user)}
async function logout(){if(sb)await sb.auth.signOut();S=null;db={products:[],sales:[],expenses:[],users:[]};$('lg').classList.add('show')}
function enter(){$('lg').classList.remove('show');$('nav').innerHTML=TABS.filter(t=>can(A[t[0]])).map(t=>`<button data-id="${t[0]}" onclick="show('${t[0]}')">${t[1]}</button>`).join('');$('who').textContent=S.name+' · '+S.role;$('userBtn').textContent='👤 '+S.name+' ▾';const f=TABS.find(t=>can(A[t[0]]));show(f?f[0]:'ventas')}
function show(id){if(!can(A[id])&&id!=='ventas')return;document.querySelectorAll('.section').forEach(x=>x.classList.toggle('active',x.id===id));document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x.dataset.id===id));$('userMenu').classList.remove('show');$('nav').classList.remove('open');refresh()}
document.addEventListener('click',e=>{if(!e.target.closest('.userwrap'))$('userMenu').classList.remove('show')});
const cm=id=>$(id).classList.remove('show'),om=id=>$(id).classList.add('show');
const num=id=>+$(id).value,val=id=>$(id).value.trim();
// Productos
let photoTmp='';
const th=p=>p&&p.photo?`<img class="th" src="${p.photo}" alt="">`:'<span class="th">👗</span>';
const showPh=()=>{$('pPrev').innerHTML=th({photo:photoTmp})};
function clrPhoto(){photoTmp='';$('pFile').value='';showPh()}
function pickPhoto(inp){const f=inp.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const k=Math.min(1,200/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);c.getContext('2d').drawImage(im,0,0,c.width,c.height);photoTmp=c.toDataURL('image/jpeg',.72);showPh()};im.onerror=()=>alert('No se pudo leer la imagen.');im.src=r.result};r.readAsDataURL(f)}
let eP=null,varTmp=[];
const tot=p=>sum(p.variants,v=>v.stock),vtxt=v=>v.size+'/'+v.color;
const prod=id=>db.products.find(x=>x.id===id),vr=(p,id)=>p.variants.find(x=>x.id===id)||p.variants[0],lbl=(p,v)=>p.name+' ('+vtxt(v)+')';
function rVar(){$('varBox').innerHTML=varTmp.map((v,i)=>`<div class="sp" style="margin:6px 0"><input placeholder="Talla" value="${esc(v.size)}" oninput="varTmp[${i}].size=this.value" style="width:90px"><input placeholder="Color" value="${esc(v.color)}" oninput="varTmp[${i}].color=this.value" style="width:120px"><input type="number" min="0" placeholder="Stock" value="${v.stock}" oninput="varTmp[${i}].stock=this.value" style="width:90px"><button class="sb danger" onclick="varTmp.splice(${i},1);rVar()">×</button></div>`).join('')}
function addVar(){varTmp.push({id:uid(),size:'',color:'',stock:0});rVar()}
function openP(id){if(!can('inv'))return;eP=id||null;const p=prod(id)||{};$('pT').textContent=id?'Editar producto':'Agregar producto';
[['pCode','code'],['pName','name'],['pCost','cost'],['pPrice','price']].forEach(f=>$(f[0]).value=p[f[1]]??'');$('pCat').value=p.cat||'Ropa';
varTmp=p.variants?p.variants.map(v=>({...v})):[{id:uid(),size:'',color:'',stock:0}];rVar();photoTmp=p.photo||'';$('pFile').value='';showPh();om('pM')}
async function saveP(){if(!can('inv'))return;const vs=varTmp.map(v=>({id:v.id,size:String(v.size).trim()||'Única',color:String(v.color).trim()||'Variado',stock:Math.floor(+v.stock)}));
const p={code:val('pCode'),name:val('pName'),cat:$('pCat').value,cost:num('pCost')||0,price:num('pPrice'),photo:photoTmp,variants:vs};
if(!p.code||!p.name||!(p.price>0)){alert('Completa código, nombre y un precio de venta mayor a 0.');return}
if(p.cost<0||!vs.length||vs.some(v=>!(v.stock>=0))){alert('Costo y existencias deben ser válidos y debe haber al menos una variante.');return}
if(new Set(vs.map(vtxt)).size<vs.length){alert('Hay variantes repetidas (misma talla y color).');return}
if(db.products.some(x=>x.code===p.code&&x.id!==eP)){alert('Ese código ya existe.');return}
const r=eP?await sb.from('products').update(p).eq('id',eP):await sb.from('products').insert(p);if(!chk(r))return;cm('pM');save()}
let stP=null;
function addStock(id){if(!can('inv'))return;stP=id;const p=prod(id);$('stT').textContent='Reponer: '+p.name;$('stV').innerHTML=p.variants.map(v=>`<option value="${v.id}">${esc(vtxt(v))} (stock ${v.stock})</option>`).join('');$('stQ').value=1;om('sM')}
async function doStock(){const p=prod(stP),v=p&&p.variants.find(x=>x.id===$('stV').value),n=parseInt($('stQ').value);if(!v||!(n>0)){alert('Cantidad inválida.');return}v.stock+=n;const r=await sb.from('products').update({variants:p.variants}).eq('id',p.id);if(!chk(r))return;cm('sM');save()}
function delP(id){if(!can('inv'))return;ask('¿Eliminar este producto? Las ventas ya registradas se conservan.',async()=>{const r=await sb.from('products').delete().eq('id',id);if(chk(r))save()})}
function rInv(){const q=$('q').value.toLowerCase(),c=$('cf').value;
$('invB').innerHTML=db.products.filter(p=>(!c||p.cat===c)&&[p.code,p.name,p.cat,...p.variants.map(vtxt)].join(' ').toLowerCase().includes(q)).map(p=>`<tr><td>${th(p)}</td><td>${esc(p.code)}</td><td>${esc(p.name)}</td><td>${esc(p.cat)}</td><td>${p.variants.map(v=>`<span class="badge ${v.stock<=2?'low':''}">${esc(vtxt(v))}: ${v.stock}</span>`).join(' ')}</td><td>${money(p.cost)}</td><td>${money(p.price)}</td><td><b>${tot(p)}</b></td><td class="acts"><button class="sb" onclick="addStock('${p.id}')">+ Stock</button><button class="sb" onclick="openP('${p.id}')">Editar</button><button class="sb danger" onclick="delP('${p.id}')">Eliminar</button></td></tr>`).join('')||'<tr><td colspan="9">No hay productos.</td></tr>'}
// Ventas
let cart=[];
function fillV(){const p=prod($('sP').value);$('sV').innerHTML=p?p.variants.map(v=>`<option value="${v.id}" ${v.stock<1?'disabled':''}>${esc(vtxt(v))} — ${v.stock>0?'stock '+v.stock:'agotado'}</option>`).join(''):''}
function rPrev(){const p=prod($('sP').value),v=p&&vr(p,$('sV').value);$('prev').innerHTML=p?th(p)+`<div><b>${esc(p.name)}</b><div class="sub">Talla ${esc(v.size)} · Color ${esc(v.color)} · ${money(p.price)} · Stock ${v.stock}</div></div>`:''}
function addCart(){const p=prod($('sP').value),v=p&&p.variants.find(x=>x.id===$('sV').value),q=num('sQ');if(!v){alert('Elige producto y variante.');return}if(!Number.isInteger(q)||q<1){alert('Cantidad inválida.');return}
const l=cart.find(x=>x.vid===v.id),n=(l?l.qty:0)+q;if(n>v.stock){alert('No hay suficiente inventario (quedan '+v.stock+').');return}
if(l)l.qty=n;else cart.push({pid:p.id,vid:v.id,qty:q});$('sQ').value=1;rCart()}
function rmCart(i){cart.splice(i,1);rCart()}
function rCart(){cart=cart.filter(l=>{const p=prod(l.pid);return p&&p.variants.some(v=>v.id===l.vid)});$('cartB').innerHTML=cart.map((l,i)=>{const p=prod(l.pid),v=vr(p,l.vid);return `<tr><td>${th(p)}${esc(lbl(p,v))}</td><td>${l.qty}</td><td>${money(p.price*l.qty)}</td><td><button class="sb danger" onclick="rmCart(${i})">Quitar</button></td></tr>`}).join('')||'<tr><td colspan="4">El carrito está vacío.</td></tr>';$('cartT').textContent=money(sum(cart,l=>prod(l.pid).price*l.qty))}
async function addSale(){if(!cart.length){alert('Agrega al menos un producto.');return}
const r=await sb.rpc('register_sale',{p_items:cart.map(l=>({pid:l.pid,vid:l.vid,qty:l.qty})),p_pay:$('sPay').value,p_seller:$('sSel').value||S.name});if(!chk(r))return;cart=[];await load();alert('Venta registrada y descontada del inventario.')}
function voidSale(id){const s=db.sales.find(x=>x.id===id);if(!can('inv')||!s||s.void)return;ask('¿Anular esta venta? El stock se devolverá al inventario.',async()=>{const r=await sb.rpc('void_sale',{sid:id});if(chk(r))save()})}
const pad=n=>String(n).padStart(2,'0'),ymd=t=>{const d=new Date(t);return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())};
function days(){const o={};db.sales.filter(s=>!s.void).forEach(s=>{const k=ymd(s.ts),d=o[k]=o[k]||{k,n:0,u:0,t:0,y:0,tr:0,e:0};d.n++;d.u+=s.qty;d.t+=s.total;s.pay==='Yappy'?d.y+=s.total:s.pay==='Efectivo'?d.e+=s.total:d.tr+=s.total});return Object.values(o).sort((a,b)=>b.k.localeCompare(a.k))}
const mine=()=>can('rep')?db.sales:db.sales.filter(s=>s.seller===(S&&S.name));
// Egresos
let eE=null;
function openE(id){eE=id||null;const e=db.expenses.find(x=>x.id===id)||{};$('eT').textContent=id?'Editar egreso':'Registrar egreso';$('eC').value=e.concept||'';$('eA').value=e.amount||'';$('eCat').value=e.cat||'Compra de mercancía';om('eM')}
async function saveE(){const c=val('eC'),a=num('eA'),cat=$('eCat').value;if(!c||!(a>0)){alert('Completa concepto y un monto mayor a 0.');return}
const o={concept:c,amount:a,cat},r=eE?await sb.from('expenses').update(o).eq('id',eE):await sb.from('expenses').insert(o);if(!chk(r))return;cm('eM');save()}
function delE(id){ask('¿Eliminar este egreso?',async()=>{const r=await sb.from('expenses').delete().eq('id',id);if(chk(r))save()})}
// Usuarios
let eU=-1;
function openU(i=-1){eU=i;const u=i<0?{name:'',email:'',role:'Vendedora',inv:false,sales:true,exp:false,rep:false,users:false}:db.users[i];$('uT').textContent=i<0?'Nuevo usuario':'Editar usuario';$('uN').value=u.name;$('uU').value=u.email||'';$('uU').disabled=i>=0;$('uP').value='';$('uP').disabled=i>=0;$('uP').placeholder=i<0?'Contraseña (mínimo 6)':'(la clave se cambia en Supabase)';$('uR').value=u.role;PERMS.forEach(p=>$('pm_'+p).checked=!!u[p]);om('uM')}
function rolePerms(){const r=ROLES[$('uR').value];PERMS.forEach((p,i)=>$('pm_'+p).checked=!!r[i])}
async function saveU(){const o={name:val('uN'),role:$('uR').value};PERMS.forEach(p=>o[p]=$('pm_'+p).checked);if(!o.name){alert('Escribe el nombre.');return}
if(eU>=0){if(!chk(await sb.from('profiles').update(o).eq('id',db.users[eU].id)))return}else{const em=val('uU'),pw=$('uP').value;if(!em||pw.length<6){alert('Escribe un correo y una contraseña de al menos 6 caracteres.');return}
const c2=supabase.createClient(SB_URL,SB_KEY,{auth:{persistSession:false,autoRefreshToken:false}}),{data,error}=await c2.auth.signUp({email:em,password:pw});if(error||!data.user){alert(error?error.message:'No se pudo crear el usuario.');return}
if(!chk(await sb.from('profiles').insert({id:data.user.id,email:em,active:true,...o})))return}
cm('uM');save()}
async function togU(i){const u=db.users[i];if(u.id===S.id){alert('No puedes bloquear tu propio usuario.');return}if(chk(await sb.from('profiles').update({active:!u.active}).eq('id',u.id)))save()}
function delU(i){const u=db.users[i];if(u.id===S.id){alert('No puedes eliminar tu propio usuario.');return}ask('¿Quitar el perfil de este usuario? Ya no podrá entrar.',async()=>{if(chk(await sb.from('profiles').delete().eq('id',u.id)))save()})}
// CSV
const invRows=()=>[['Código','Producto','Categoría','Talla','Color','Costo','Venta','Stock'],...db.products.flatMap(p=>p.variants.map(v=>[p.code,p.name,p.cat,v.size,v.color,p.cost,p.price,v.stock]))];
const salRows=k=>[['Fecha','Producto','Cantidad','Pago','Vendedora','Total','Estado'],...db.sales.filter(s=>!k||ymd(s.ts)===k).map(s=>[fd(s.ts),s.product,s.qty,s.pay,s.seller,s.total,s.void?'Anulada':'Válida'])];
const dayCsv=()=>[['Día','Ventas','Unidades','Yappy','Transferencia','Efectivo','Total'],...days().map(d=>[d.k,d.n,d.u,d.y,d.tr,d.e,d.t])];
const expRows=()=>[['Fecha','Concepto','Categoría','Monto'],...db.expenses.map(e=>[fd(e.ts),e.concept,e.cat,e.amount])];
function csv(n,rows){const t=rows.map(r=>r.map(v=>'"'+String(v).replaceAll('"','""')+'"').join(',')).join('\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+t],{type:'text/csv;charset=utf-8'}));a.download='limboutique_'+n+'.csv';a.click()}
// Pantallas
const sum=(a,f)=>a.reduce((t,x)=>t+f(x),0),grp=(a,k,v)=>Object.entries(a.reduce((o,x)=>(o[x[k]]=(o[x[k]]||0)+v(x),o),{})).map(([k,v])=>`<tr><td>${esc(k)}</td><td>${money(v)}</td></tr>`).join('')||'<tr><td>Sin datos</td></tr>';
function refresh(){const ok=db.sales.filter(s=>!s.void),cur=ym(new Date()),units=sum(db.products,tot);
const ms=ok.filter(s=>ym(s.ts)===cur),me=db.expenses.filter(e=>ym(e.ts)===cur),a=sum(ms,s=>s.total),b=sum(me,e=>e.amount);
$('dS').textContent=money(a);$('dE').textContent=money(b);$('dR').textContent=money(a-b);$('dU').textContent=units;
const row=s=>`<tr class="${s.void?'void':''}"><td>${fd(s.ts)}</td><td>${esc(s.product)}</td><td>${esc(s.pay)}</td><td>${money(s.total)}</td></tr>`;
$('recent').innerHTML='<tr><th>Fecha</th><th>Producto</th><th>Pago</th><th>Total</th></tr>'+db.sales.slice(0,6).map(row).join('');
$('lowS').innerHTML='<tr><th>Producto</th><th>Stock</th></tr>'+db.products.flatMap(p=>p.variants.filter(v=>v.stock<=2).map(v=>`<tr><td>${esc(p.name)} (${esc(vtxt(v))})</td><td><span class="badge low">${v.stock}</span></td></tr>`)).join('');
const m=$('mSel').value,rs=m?ok.filter(s=>ym(s.ts)===m):ok,re=m?db.expenses.filter(e=>ym(e.ts)===m):db.expenses,rv=sum(rs,s=>s.total),rx=sum(re,e=>e.amount);
$('rS').textContent=money(rv);$('rE').textContent=money(rx);$('rR').textContent=money(rv-rx);$('rM').textContent=money(rv-sum(rs,s=>s.cost));
$('rPay').innerHTML=grp(rs,'pay',s=>s.total);$('rCat').innerHTML=grp(re,'cat',e=>e.amount);$('dayB').innerHTML=days().filter(d=>!m||d.k.startsWith(m)).map(d=>`<tr><td>${d.k}</td><td>${d.n}</td><td>${d.u}</td><td>${money(d.y)}</td><td>${money(d.tr)}</td><td>${money(d.e)}</td><td><b>${money(d.t)}</b></td><td><button class="sb" onclick="csv('ventas_${d.k}',salRows('${d.k}'))">⬇ CSV</button></td></tr>`).join('')||'<tr><td colspan="8">Aún no hay ventas.</td></tr>';
const cur2=$('sP').value;$('sP').innerHTML=db.products.map(p=>`<option value="${p.id}">${esc(p.name)} — ${money(p.price)}</option>`).join('');$('sP').value=cur2;const cv=$('sV').value;fillV();if([...$('sV').options].some(o=>o.value===cv))$('sV').value=cv;rPrev();rCart();
const cs=$('sSel').value;$('sSel').innerHTML=(can('users')?db.users:[S]).filter(u=>u&&u.active&&u.sales).map(u=>`<option>${esc(u.name)}</option>`).join('');$('sSel').value=cs;if(S&&!can('rep')){$('sSel').value=S.name;$('sSel').disabled=true}else $('sSel').disabled=false;
rInv();
$('salB').innerHTML=mine().map(s=>`<tr class="${s.void?'void':''}"><td>${fd(s.ts)}</td><td>${esc(s.product)}</td><td>${s.qty}</td><td>${esc(s.pay)}</td><td>${esc(s.seller)}</td><td>${money(s.total)}</td><td>${s.void?'Anulada':can('inv')?`<button class="sb danger" onclick="voidSale('${s.id}')">Anular</button>`:'-'}</td></tr>`).join('')||'<tr><td colspan="7">Aún no hay ventas.</td></tr>';
$('expB').innerHTML=db.expenses.map(e=>`<tr><td>${fd(e.ts)}</td><td>${esc(e.concept)}</td><td>${esc(e.cat)}</td><td>${money(e.amount)}</td><td class="acts"><button class="sb" onclick="openE('${e.id}')">Editar</button><button class="sb danger" onclick="delE('${e.id}')">Eliminar</button></td></tr>`).join('')||'<tr><td colspan="5">Aún no hay egresos.</td></tr>';
$('usrB').innerHTML=db.users.map((u,i)=>`<tr><td>${esc(u.name)}</td><td>${esc(u.email)}</td><td><span class="role">${esc(u.role)}</span></td><td>${u.active?'<span class="badge">Activo</span>':'<span class="badge low">Bloqueado</span>'}</td><td class="acts"><button class="sb" onclick="openU(${i})">Editar</button><button class="sb" onclick="togU(${i})">${u.active?'Bloquear':'Activar'}</button><button class="sb danger" onclick="delU(${i})">Eliminar</button></td></tr>`).join('')}
refresh();boot();setInterval(()=>{if(S&&!document.querySelector('.modal.show'))load()},30000);
</script></body></html>
